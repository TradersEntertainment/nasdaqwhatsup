# Railway PORT'u kendisi enjekte eder; yerelde varsayilan 3000.
PORT=3000

# Poll araligi (ms). Varsayilan 5 dakika.
POLL_INTERVAL_MS=300000

# 1 => Yahoo'ya hic cikilmaz, data/fixtures/snapshot.fixture.json servis edilir.
# Yerel gelistirme icin. Bu container piyasa host'larini 403'le engelledigi icin
# yerelde canli veri MUMKUN DEGIL; gelistirme daima fixture ile yapilir.
FIXTURE_MODE=0

# 1 => ilk canli cekim basarisiz olursa fixture'a duser (gurultulu banner ile).
# URETIMDE 0 BIRAKIN: bozuk deploy sessizce sahte fiyat gostermesin.
ALLOW_FIXTURE_FALLBACK=0

# Kalici disk. Railway volume baglayinca RAILWAY_VOLUME_MOUNT_PATH otomatik gelir.
# Bos birakilirsa ./.data kullanilir.
# RAILWAY_VOLUME_MOUNT_PATH=/data

# debug | info | warn | error
LOG_LEVEL=info
